{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "read": "allow",
    "external_directory": "deny",
    "webfetch": "deny",
    "bash": {
      "*": "deny",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "ls*": "allow",
      "pwd": "allow",
      "node --check *": "allow",
      "python3 -m py_compile opencode-delegate/skills/opencode/scripts/delegate.py": "allow",
      "node --check opencode-delegate/skills/opencode/scripts/opencode-plugin/scrub-env.js": "allow"
    }
  }
}
